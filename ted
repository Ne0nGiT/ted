_RX_CACHE = {}


def get_lang_rx(name):
    if name not in _RX_CACHE:
        parts = LANG_PARTS[name]
        _RX_CACHE[name] = re.compile("|".join(f"(?P<{t}>{p})" for t, p in parts), re.M)
    return _RX_CACHE[name]


def detect_lang(path, first_line=""):
    if path and "." in os.path.basename(path):
        lang = EXT_LANG.get(path.rsplit(".", 1)[-1].lower())
        if lang:
            return lang
    if first_line.startswith("#!"):
        for key, lang in (("python", "python"), ("node", "js"), ("bash", "shell"), ("sh", "shell")):
            if key in first_line:
                return lang
    return None


def tokenize(rx, text):
    """Trả về (tag, start, end); mỗi vị trí chỉ khớp 1 token nên chuỗi/comment lấn át keyword."""
    for m in rx.finditer(text):
        s, e = m.span()
        if e > s:
            yield m.lastgroup, s, e
