class Dialog(tk.Toplevel):
    """Hộp thoại tự vẽ theo theme tối. buttons = [(nhãn, giá trị)], nút đầu là mặc định."""

    def __init__(self, parent, title, message, buttons, entry=None):
        super().__init__(parent)
        self.configure(bg=BAR_BG)
        self.title(title)
        self.transient(parent)
        self.resizable(False, False)
        self.result = None
        self.entry = None

        tk.Label(self, text=message, bg=BAR_BG, fg=FG, justify="left",
                 wraplength=380, padx=22, pady=18).pack(anchor="w")
        if entry is not None:
            self.entry = tk.Entry(self, bg=FIELD_BG, fg=FG, insertbackground=FG,
                                  relief="flat", highlightthickness=1,
                                  highlightbackground="#555", highlightcolor=ACCENT)
            self.entry.insert(0, entry)
            self.entry.pack(fill="x", padx=22, pady=(0, 14), ipady=4)
            self.entry.select_range(0, "end")

        row = tk.Frame(self, bg=BAR_BG)
        row.pack(pady=(0, 16))
        self.btns = []
        for i, (label, value) in enumerate(buttons):
            b = tk.Button(row, text=label, relief="flat", bd=0, padx=16, pady=6,
                          bg=ACCENT if i == 0 else BTN_BG, fg="#ffffff" if i == 0 else FG,
                          activebackground=BTN_HOVER, activeforeground=FG,
                          command=lambda v=value: self._done(v))
            b.pack(side="left", padx=5)
            self.btns.append(b)

        self.bind("<Escape>", lambda e: self._done(None))
        self.bind("<Return>", self._enter)
        self.protocol("WM_DELETE_WINDOW", lambda: self._done(None))

        self.update_idletasks()
        x = parent.winfo_rootx() + (parent.winfo_width() - self.winfo_width()) // 2
        y = parent.winfo_rooty() + (parent.winfo_height() - self.winfo_height()) // 3
        self.geometry(f"+{max(x, 0)}+{max(y, 0)}")
        try:
            self.wait_visibility()
            self.grab_set()
        except tk.TclError:
            pass
        (self.entry or self.btns[0]).focus_set()
        self.wait_window()

    def _enter(self, _e):
        w = self.focus_get()
        if isinstance(w, tk.Button):
            w.invoke()
        else:
            self.btns[0].invoke()

    def _done(self, value):
        if self.entry is not None and value is not None:
            value = self.entry.get()
        self.result = value
        self.destroy()


