_ANSI = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")


def clean_output(s):
    """Bỏ mã màu ANSI, đổi \r thành xuống dòng."""
    return _ANSI.sub("", s).replace("\r\n", "\n").replace("\r", "\n")


def build_run_cmd(path, first_line="", out="/tmp/ted-run"):
    """Trả về (lệnh, chương trình cần có), hoặc (None, lý do) nếu không biết cách chạy file này."""
    base = os.path.basename(path)
    ext = base.rsplit(".", 1)[-1].lower() if "." in base else ""
    tpl = RUN_CMDS.get(ext)
    if tpl is None and first_line.startswith("#!"):  # file không đuôi: theo dòng #! đầu file
        try:
            parts = shlex.split(first_line[2:].strip())
        except ValueError:
            parts = []
        if parts:
            tpl = parts + ["{file}"]
    if tpl is None:
        what = f".{ext}" if ext else "không có đuôi"
        return None, f"Chưa biết cách chạy file ({what}).\nHỗ trợ: " + ", ".join(sorted(RUN_CMDS))
    cmd = [a.replace("{file}", path).replace("{out}", out) for a in tpl]
    return cmd, RUN_NEEDS.get(ext) or cmd[0]


def read_process(proc, q):
    """Chạy trong luồng riêng: đọc output (không đợi xuống dòng, để thấy cả dấu nhắc input) rồi đẩy vào hàng đợi."""
    dec = codecs.getincrementaldecoder("utf-8")(errors="replace")
    try:
        while True:
            data = os.read(proc.stdout.fileno(), 4096)
            if not data:
                break
            q.put(("out", dec.decode(data)))
    except OSError:
        pass
    tail = dec.decode(b"", final=True)
    if tail:
        q.put(("out", tail))
    q.put(("end", proc.wait()))
# <<< RUNNER-END

