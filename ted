    def _code_part(self, line):
        """Phần code của dòng, bỏ comment ở cuối (không cắt nhầm # hoặc // nằm trong chuỗi)."""
        marker = {"python": "#", "shell": "#", "conf": "#", "js": "//", "c": "//"}.get(self.lang_key)
        if not marker:
            return line
        quote, i = None, 0
        while i < len(line):
            ch = line[i]
            if quote:
                if ch == "\\":
                    i += 2
                    continue
                if ch == quote:
                    quote = None
            elif ch in "\"'`":
                quote = ch
            elif line.startswith(marker, i):
                return line[:i]
            i += 1
        return line

    def auto_indent(self):
        t = self.text
        line = t.get("insert linestart", "insert")
        ws = line[: len(line) - len(line.lstrip(" \t"))]
        unit = "\t" if (ws.endswith("\t") or (not ws and self.indent_unit == "\t")) else "    "
        nxt = t.get("insert", "insert+1c")
        rest_empty = t.get("insert", "insert lineend").strip() == ""
        opener = self._code_part(line).rstrip()[-1:]  # ký tự cuối của phần code (bỏ comment)
        if line.strip() == "" and rest_empty:
            # Enter trên dòng chỉ có khoảng trắng: dòng đó trở thành dòng trống thật (không để lại
            # tab/dấu cách thừa), dòng mới vẫn giữ mức thụt lề để gõ tiếp
            t.delete("insert linestart", "insert lineend")
            t.insert("insert", "\n" + ws)
        elif self.lang_rx and line[-1:] in ("(", "[", "{") and PAIRS.get(line[-1:]) == nxt:
            # Enter giữa cặp {|} -> mở thành 3 dòng, con trỏ ở dòng giữa đã thụt lề
            t.insert("insert", "\n" + ws + unit + "\n" + ws)
            t.mark_set("insert", f"insert-{len(ws) + 1}c")
        elif self.lang_rx and rest_empty and (opener in ("(", "[", "{") or (opener == ":" and self.lang_key == "python")):
            t.insert("insert", "\n" + ws + unit)  # sau dòng mở khối: thụt thêm 1 cấp
        else:
            t.insert("insert", "\n" + ws)
        t.see("insert")

    # ---------- tự đóng ngoặc / nháy (chỉ khi là file code) ----------
    def _on_keypress(self, e):
        if self.lang_rx is None or not e.char or e.char not in "([{)]}\"'`":
            return
        if e.state & 0xC:  # Ctrl / Alt
            return
        t, ch = self.text, e.char
        pair = PAIRS.get(ch)
        if t.tag_ranges("sel"):
            if not pair:
                return
            a, b = t.index("sel.first"), t.index("sel.last")
            inner = t.get(a, b)
            t.replace(a, b, ch + inner + pair)  # bọc phần đang chọn
            t.tag_remove("sel", "1.0", "end")
            t.tag_add("sel", f"{a}+1c", f"{a}+{len(inner) + 1}c")
            t.mark_set("insert", f"{a}+{len(inner) + 1}c")
            return "break"
        nxt = t.get("insert", "insert+1c")
        if ch in CLOSERS and nxt == ch:  # gõ đè ký tự đóng đã có sẵn
            t.mark_set("insert", "insert+1c")
            t.see("insert")
            return "break"
        if not pair:
            return
        if nxt and not (nxt.isspace() or nxt in AFTER_OK):
            return  # đang đứng trước chữ: không tự đóng
        prev = t.get("insert-1c", "insert") if t.compare("insert", ">", "1.0") else ""
        if ch in "\"'`":
            if self.lang_key == "python" and ch != "`" and prev == ch and t.get("insert-2c", "insert") == ch * 2:
                t.insert("insert", ch * 4)  # """|"""
                t.mark_set("insert", "insert-3c")
                return "break"
            if prev == "\\":
                return
            if prev.isalnum() or prev == "_":
                # chữ đứng trước (don't, it's...) -> không đóng; riêng Python cho f"..." b'...' r"..."
                if not (self.lang_key == "python" and prev in "rRbBuUfF"
                        and not (lambda c: c.isalnum() or c == "_")(t.get("insert-2c", "insert-1c"))):
                    return
        t.insert("insert", ch + pair)
        t.mark_set("insert", "insert-1c")
        t.see("insert")
        return "break"

    def _on_backspace(self, e):
        t = self.text
        if self.lang_rx is None or t.tag_ranges("sel") or t.compare("insert", "==", "1.0"):
            return
        prev, nxt = t.get("insert-1c", "insert"), t.get("insert", "insert+1c")
        if prev in PAIRS and PAIRS[prev] == nxt:  # xóa cả cặp rỗng ()
            t.delete("insert-1c", "insert+1c")
            return "break"

    def duplicate_line(self):
        line = self.text.get("insert linestart", "insert lineend")
        self.text.insert("insert lineend", "\n" + line)

    def del_word_left(self):
        if self.text.compare("insert", ">", "1.0"):
            self.text.delete("insert -1c wordstart", "insert")

    def del_word_right(self):
        self.text.delete("insert", "insert wordend")

    def goto_line(self):
        total = int(self.text.index("end-1c").split(".")[0])
        val = ask_text(self.root, "Đến dòng", f"Số dòng (1-{total}):")
        if val and val.strip().isdigit():
            n = max(1, min(total, int(val)))
            self.text.mark_set("insert", f"{n}.0")
            self.text.see("insert")
            self.refresh()
        self.text.focus_set()

    def zoom(self, d):
        size = 12 if d == 0 else max(6, min(48, self.font.cget("size") + d))
        self.font.configure(size=size)
        self._set_tabs()
        self._schedule_gutter()

    def _set_tabs(self):
        self.text.configure(tabs=(self.font.measure(" " * 4),))

    # ---------- find / replace ----------
    def open_find(self, replace):
        self.find_bar.pack(side="bottom", fill="x", before=self.status)
        if replace:
            self.repl_frame.pack(side="left")
        else:
            self.repl_frame.pack_forget()
        if self.text.tag_ranges("sel"):
            self.find_var.set(self.text.get("sel.first", "sel.last").split("\n")[0])
        self.find_entry.focus_set()
        self.find_entry.select_range(0, "end")
        self.highlight_matches()

    def close_find(self):
        self.find_bar.pack_forget()
        self.text.tag_remove("match", "1.0", "end")
        self.text.focus_set()

    def highlight_matches(self):
        self.text.tag_remove("match", "1.0", "end")
        pat = self.find_var.get()
        if not pat:
            self.find_info.config(text="")
            return
        n, idx = 0, "1.0"
        while n < 5000:
            cnt = tk.IntVar()
            idx = self.text.search(pat, idx, stopindex="end", nocase=True, count=cnt)
            if not idx or cnt.get() == 0:
                break
            end = f"{idx}+{cnt.get()}c"
            self.text.tag_add("match", idx, end)
            idx, n = end, n + 1
        self.find_info.config(text=f"{n} kết quả" if n else "Không thấy")

    def find_next(self, backwards):
        pat = self.find_var.get()
        if not pat:
            return
        cnt = tk.IntVar()
        if backwards:
            start = self.text.index("sel.first") if self.text.tag_ranges("sel") else self.text.index("insert")
            idx = self.text.search(pat, start, stopindex="1.0", backwards=True, nocase=True, count=cnt) \
                or self.text.search(pat, "end", stopindex="1.0", backwards=True, nocase=True, count=cnt)
        else:
            start = self.text.index("sel.last") if self.text.tag_ranges("sel") else self.text.index("insert")
            idx = self.text.search(pat, start, stopindex="end", nocase=True, count=cnt) \
                or self.text.search(pat, "1.0", stopindex="end", nocase=True, count=cnt)
        if not idx:
            return
        end = f"{idx}+{cnt.get()}c"
        self.text.tag_remove("sel", "1.0", "end")
        self.text.tag_add("sel", idx, end)
        self.text.mark_set("insert", end if not backwards else idx)
        self.text.see(idx)

    def replace_one(self):
        if self.text.tag_ranges("sel") and \
                self.text.get("sel.first", "sel.last").lower() == self.find_var.get().lower():
            self.text.replace("sel.first", "sel.last", self.repl_var.get())
        self.find_next(False)
        self.highlight_matches()
        self.schedule_highlight()

    def replace_all(self):
        pat = self.find_var.get()
        if not pat:
            return
        idx, n = "1.0", 0
        self.text.edit_separator()
        while True:
            cnt = tk.IntVar()
            idx = self.text.search(pat, idx, stopindex="end", nocase=True, count=cnt)
            if not idx or cnt.get() == 0:
                break
            end = f"{idx}+{cnt.get()}c"
            self.text.replace(idx, end, self.repl_var.get())
            idx = f"{idx}+{len(self.repl_var.get())}c"
            n += 1
        self.text.edit_separator()
        self.highlight_matches()
        self.find_info.config(text=f"Đã thay {n}")
        self.schedule_highlight()

    # ---------- code runner (F5) ----------
    def show_output(self, show=True):
        if show and not self.run_visible:
            self.run_panel.pack(side="bottom", fill="x", after=self.status)
            self.run_visible = True
        elif not show and self.run_visible:
            self.run_panel.pack_forget()
            self.run_visible = False
            self.text.focus_set()

    def _out_append(self, s, tag=None):
        o = self.out
        o.configure(state="normal")
        o.insert("end", s, tag or ())
        lines = int(o.index("end-1c").split(".")[0])
        if lines > 5000:  # chống tràn bộ nhớ khi chương trình in vô tận
            o.delete("1.0", f"{lines - 4000}.0")
        o.configure(state="disabled")
        o.see("end")

    def _out_clear(self):
        self.out.configure(state="normal")
        self.out.delete("1.0", "end")
        self.out.configure(state="disabled")

    def _set_run_status(self, text, color=BAR_FG):
        self.run_status.config(text=text, fg=color)

    def run_file(self, _e=None):
        if not self.path:
            self.save_as()
            if not self.path:
                return "break"
        elif self.text.edit_modified():
            self.save()  # lưu trước khi chạy để không chạy bản cũ
            if self.text.edit_modified():
                return "break"
        self.stop_run(quiet=True)
        self.show_output(True)
        self._out_clear()
        out_bin = os.path.join(tempfile.gettempdir(), f"ted-run-{os.getpid()}")
        cmd, need = build_run_cmd(self.path, self.text.get("1.0", "1.end"), out_bin)
        if cmd is None:
            self._out_append(need + "\n", "err")
            self._set_run_status("không chạy được", "#f48771")
            return "break"
        if not shutil.which(need):
            hint = INSTALL_HINT.get(need)
            self._out_append(f"Không tìm thấy '{need}'." + (f"\nCài bằng: sudo apt install {hint}" if hint else "") + "\n", "err")
            self._set_run_status("thiếu chương trình", "#f48771")
            return "break"
        label = f"{need} {os.path.basename(self.path)}" if cmd[0] == "sh" else " ".join(shlex.quote(a) for a in cmd)
        self._out_append(f"$ {label}\n", "info")
        try:
            self.proc = subprocess.Popen(
                cmd, cwd=os.path.dirname(self.path) or None, stdin=subprocess.PIPE,
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT, bufsize=0,
                start_new_session=True, env=dict(os.environ, PYTHONUNBUFFERED="1"))
        except OSError as e:
            self._out_append(f"Không chạy được: {e}\n", "err")
            self._set_run_status("lỗi", "#f48771")
            return "break"
        self._run_out_bin = out_bin
        self._run_killed = False
        self._run_start = time.time()
        self._run_gen += 1
        self._run_q = queue.Queue(maxsize=2000)
        threading.Thread(target=read_process, args=(self.proc, self._run_q), daemon=True).start()
        self._set_run_status("đang chạy…", "#dcdcaa")
        self._poll_run(self._run_gen)
        return "break"

    def _poll_run(self, gen):
        if gen != self._run_gen:  # lần chạy cũ đã bị thay thế
            return
        ended = None
        for _ in range(200):
            try:
                kind, val = self._run_q.get_nowait()
            except queue.Empty:
                break
            if kind == "out":
                self._out_append(clean_output(val))
            else:
                ended = val
                break
        if ended is not None:
            self._finish_run(ended)
        else:
            self.root.after(30, self._poll_run, gen)

    def _finish_run(self, code):
        dt = time.time() - self._run_start
        if self._run_killed:
            msg, tag, color, st = f"\n[đã dừng · {dt:.2f}s]\n", "info", BAR_FG, "đã dừng"
        elif code == 0:
            msg, tag, color, st = f"\n[xong · mã thoát 0 · {dt:.2f}s]\n", "ok", "#89d185", "xong"
        else:
            msg, tag, color, st = f"\n[lỗi · mã thoát {code} · {dt:.2f}s]\n", "err", "#f48771", f"lỗi ({code})"
        self._out_append(msg, tag)
        self._set_run_status(f"{st} · {dt:.2f}s", color)
        p, self.proc = self.proc, None
        for f in (getattr(p, "stdin", None), getattr(p, "stdout", None)):
            try:
                f.close()
            except (OSError, AttributeError):
                pass
        try:
            os.remove(self._run_out_bin)  # file tạm khi biên dịch C/C++/Rust
        except OSError:
            pass

    def stop_run(self, quiet=False, force=False):
        p = self.proc
        if p is None or p.poll() is not None:
            return
        self._run_killed = True
        try:
            os.killpg(os.getpgid(p.pid), signal.SIGKILL if force else signal.SIGTERM)
        except OSError:
            pass
        if not force:
            self.root.after(1500, self._kill9, p)  # nếu 1,5 giây sau vẫn chưa chết thì buộc dừng
        if quiet:  # bỏ qua kết quả của lần chạy cũ
            self._run_gen += 1
            self.proc = None

    def _kill9(self, p):
        if p.poll() is None:
            try:
                os.killpg(os.getpgid(p.pid), signal.SIGKILL)
            except OSError:
                pass

    def _send_stdin(self, _e=None):
        text = self.stdin_var.get()
        self.stdin_var.set("")
        p = self.proc
        if p is None or p.poll() is not None:
            return "break"
        try:
            p.stdin.write((text + "\n").encode("utf-8"))
            p.stdin.flush()
        except (OSError, ValueError):
            pass
        self._out_append(text + "\n", "inp")  # chương trình không tự in lại phần mình gõ
        return "break"

    def _close_stdin(self, _e=None):
        p = self.proc
        if p is not None and p.stdin:
            try:
                p.stdin.close()
            except OSError:
                pass
        return "break"

    # ---------- tô các chữ trùng với chữ đang chọn / đang đặt con trỏ ----------
    def toggle_occ(self):
        self.occ_on = not self.occ_on
        if self.occ_on:
            self.schedule_occ(20)
        else:
            self.text.tag_remove("occ", "1.0", "end")

    def schedule_occ(self, delay=200):
        if self.lang_rx is None or not self.occ_on:
            return
        if self._occ_job is not None:
            self.root.after_cancel(self._occ_job)
        self._occ_job = self.root.after(delay, self.highlight_occurrences)

    def _occ_target(self):
        """(chuỗi cần tô, khớp nguyên từ?) hoặc None."""
        t = self.text
        if t.tag_ranges("sel"):
            a, b = t.index("sel.first"), t.index("sel.last")
            if a.split(".")[0] != b.split(".")[0]:
                return None  # vùng chọn nhiều dòng: bỏ qua
            sel = t.get(a, b)
            if not sel or len(sel) > 80 or sel != sel.strip():
                return None
            return sel, bool(re.fullmatch(r"\w+", sel))
        line_no, col = (int(x) for x in t.index("insert").split("."))
        line = t.get(f"{line_no}.0", f"{line_no}.end")
        for m in re.finditer(r"\w+", line):
            if m.start() <= col <= m.end():
                return m.group(), True
        return None

    def highlight_occurrences(self):
        self._occ_job = None
        t = self.text
        t.tag_remove("occ", "1.0", "end")
        if self.lang_rx is None or not self.occ_on:
            return
        target = self._occ_target()
        if not target:
            return
        word, whole = target
        total = int(t.index("end-1c").split(".")[0])
        first, last = self._visible_lines()
        a, b = max(1, first - PAD_LINES), min(total, last + PAD_LINES)
        pat = "\\m" + word + "\\M" if whole else word  # \m \M = đầu/cuối từ (regex của Tk)
        spans, idx, stop, cnt = [], f"{a}.0", f"{b}.end", tk.IntVar()
        while len(spans) < 3000:
            idx = t.search(pat, idx, stopindex=stop, regexp=whole, count=cnt)
            if not idx or cnt.get() == 0:
                break
            end = f"{idx}+{cnt.get()}c"
            spans.extend((idx, end))
            idx = end
        if len(spans) >= 4:  # ít nhất 2 chỗ mới đáng tô
            t.tag_add("occ", *spans)

    # ---------- số dòng (gutter) ----------
    def toggle_lines(self):
        self.show_lines = not self.show_lines
        if self.show_lines:
            self.gutter.pack(side="left", fill="y", before=self.text)
            self._schedule_gutter()
        else:
            self.gutter.pack_forget()

    def _schedule_gutter(self):
        if self.show_lines and self._gutter_job is None:
            self._gutter_job = self.root.after_idle(self._draw_gutter)

    def _draw_gutter(self):
        """Chỉ vẽ số cho các dòng đang nhìn thấy -> nhẹ, không phụ thuộc độ dài file."""
        self._gutter_job = None
        if not self.show_lines:
            return
        t, c = self.text, self.gutter
        total = int(t.index("end-1c").split(".")[0])
        width = self.font.measure("0") * max(3, len(str(total))) + 22
        if int(c.cget("width")) != width:
            c.configure(width=width)
        c.delete("all")
        first = int(t.index("@0,0").split(".")[0])
        last = int(t.index(f"@0,{max(t.winfo_height(), 1)}").split(".")[0])
        cur = int(t.index("insert").split(".")[0])
        descent = self.font.metrics("descent")
        for n in range(first, min(last, total) + 1):
            info = t.dlineinfo(f"{n}.0")  # None nếu dòng đầu của dòng logic nằm ngoài màn hình
            if info is None:
                continue
            c.create_text(width - 12, info[1] + info[4] + descent, anchor="se", text=str(n),
                          font=self.font, fill=GUTTER_CUR if n == cur else GUTTER_FG)

    def _gutter_click(self, e):
        """Bấm vào số dòng = chọn cả dòng đó (như VS Code)."""
        t = self.text
        n = int(t.index(f"@0,{e.y}").split(".")[0])
        t.focus_set()
        t.tag_remove("sel", "1.0", "end")
        t.tag_add("sel", f"{n}.0", f"{n + 1}.0")
        t.mark_set("insert", f"{n + 1}.0")
        self.refresh()
        return "break"

    def _gutter_wheel(self, e):
        up = e.num == 4 or getattr(e, "delta", 0) > 0
        self.text.yview_scroll(-3 if up else 3, "units")
        return "break"

    # ---------- icon ----------
    def _set_icon(self):
        here = os.path.dirname(os.path.abspath(__file__))
        for p in ("/usr/share/icons/hicolor/256x256/apps/ted.png", os.path.join(here, "ted.png")):
            if os.path.isfile(p):
                try:
                    self._icon = tk.PhotoImage(file=p)
                    self.root.iconphoto(True, self._icon)
                except tk.TclError:
                    pass
                return

    # ---------- nhớ vị trí con trỏ ----------
    def _pos_file(self):
        base = os.environ.get("XDG_CACHE_HOME") or os.path.join(os.path.expanduser("~"), ".cache")
        return os.path.join(base, "ted", "positions.json")

    def _load_positions(self):
        try:
            with open(self._pos_file(), "r", encoding="utf-8") as f:
                d = json.load(f)
            return d if isinstance(d, dict) else {}
        except (OSError, ValueError):
            return {}

    def _save_pos(self):
        if not self.path:
            return
        try:
            d = self._load_positions()
            d.pop(self.path, None)
            d[self.path] = self.text.index("insert")
            while len(d) > 200:
                d.pop(next(iter(d)))
            p = self._pos_file()
            os.makedirs(os.path.dirname(p), exist_ok=True)
            with open(p, "w", encoding="utf-8") as f:
                json.dump(d, f)
        except OSError:
            pass

    def _restore_pos(self):
        if not (self.path and os.path.isfile(self.path)):
            return
        try:
            line, col = (int(x) for x in str(self._load_positions().get(self.path, "")).split("."))
        except ValueError:
            return
        total = int(self.text.index("end-1c").split(".")[0])
        if line > total or (line, col) == (1, 0):
            return
        idx = f"{line}.{col}"
        self.text.mark_set("insert", idx)
        self.root.after(60, lambda: (self.text.see(idx), self.refresh()))

    # ---------- thụt lề / comment / wrap ----------
    def _detect_indent(self):
        if self.lang_rx is None:
            self.indent_unit = "\t"  # file thường: Tab là ký tự tab như nano
            return
        head = self.text.get("1.0", "400.0")
        tabs = len(re.findall(r"^\t", head, re.M))
        spaces = len(re.findall(r"^ {2,}", head, re.M))
        if tabs == spaces == 0 and self.path and (self.path.endswith(".go") or os.path.basename(self.path) == "Makefile"):
            tabs = 1
        self.indent_unit = "\t" if tabs > spaces else "    "

    def _sel_lines(self):
        """(dòng đầu, dòng cuối, có phải khối nhiều dòng) của vùng chọn, hoặc dòng hiện tại."""
        t = self.text
        if t.tag_ranges("sel"):
            a, b = t.index("sel.first"), t.index("sel.last")
            first, last = int(a.split(".")[0]), int(b.split(".")[0])
            adjusted = False
            if b.endswith(".0") and last > first:  # vùng chọn kết thúc ở đầu dòng kế -> không tính dòng đó
                last -= 1
                adjusted = True
            return first, last, (last > first or adjusted)
        n = int(t.index("insert").split(".")[0])
        return n, n, False

    def _group(self, fn):
        """Gộp các thay đổi thành 1 bước undo."""
        t = self.text
        t.edit_separator()
        t.configure(autoseparators=False)
        try:
            fn()
        finally:
            t.configure(autoseparators=True)
            t.edit_separator()

    def _reselect(self, first, last):
        t = self.text
        t.tag_remove("sel", "1.0", "end")
        t.tag_add("sel", f"{first}.0", f"{last}.end")
        t.mark_set("insert", f"{last}.end")

    def _on_tab(self, e):
        t = self.text
        if t.tag_ranges("sel"):
            first, last, block = self._sel_lines()
            if block:
                def do():
                    for n in range(first, last + 1):
                        if t.get(f"{n}.0", f"{n}.end").strip():
                            t.insert(f"{n}.0", self.indent_unit)
                self._group(do)
                self._reselect(first, last)
                return "break"
            t.delete("sel.first", "sel.last")  # chọn trong 1 dòng: Tab thay phần chọn
        if self.indent_unit == "\t":
            t.insert("insert", "\t")
        else:
            col = int(t.index("insert").split(".")[1])
            t.insert("insert", " " * (4 - col % 4))
        t.see("insert")
        return "break"

    def _on_shift_tab(self, e):
        t = self.text
        first, last, _ = self._sel_lines()

        def do():
            for n in range(first, last + 1):
                line = t.get(f"{n}.0", f"{n}.end")
                if line.startswith("\t"):
                    t.delete(f"{n}.0", f"{n}.1")
                else:
                    k = min(4, len(line) - len(line.lstrip(" ")))
                    if k:
                        t.delete(f"{n}.0", f"{n}.{k}")
        self._group(do)
        if t.tag_ranges("sel"):
            self._reselect(first, last)
        return "break"

    def toggle_comment(self):
        spec = COMMENTS.get(self.lang_key)
        if not spec:
            return
        op, cl = spec
        mark, cmark = op.strip(), cl.strip()
        t = self.text
        first, last, _ = self._sel_lines()
        had_sel = bool(t.tag_ranges("sel"))
        cur_line, cur_col = (int(x) for x in t.index("insert").split("."))
        lines = {n: t.get(f"{n}.0", f"{n}.end") for n in range(first, last + 1)}
        nonempty = [n for n, l in lines.items() if l.strip()]
        if not nonempty:
            return

        def commented(l):
            s = l.strip()
            return s.startswith(mark) and (not cmark or s.endswith(cmark))
        uncomment = all(commented(lines[n]) for n in nonempty)
        indent = min(len(lines[n]) - len(lines[n].lstrip()) for n in nonempty)
        shift = {}  # độ dịch của con trỏ trên từng dòng

        def do():
            for n in nonempty:
                l = lines[n]
                if uncomment:
                    lead = len(l) - len(l.lstrip())
                    body = l[lead + len(mark):]
                    pre = len(mark)
                    if body.startswith(" "):
                        body = body[1:]
                        pre += 1
                    shift[n] = -min(pre, max(0, cur_col - lead))
                    if cmark:
                        b2 = body.rstrip()
                        if b2.endswith(cmark):
                            body = b2[: -len(cmark)].rstrip()
                    new = l[:lead] + body
                else:
                    new = l[:indent] + op + l[indent:] + cl
                    shift[n] = len(op) if cur_col >= indent else 0
                t.delete(f"{n}.0", f"{n}.end")
                t.insert(f"{n}.0", new)
        self._group(do)
        if had_sel:
            self._reselect(first, last)
        else:
            t.mark_set("insert", f"{cur_line}.{max(0, cur_col + shift.get(cur_line, 0))}")
        self.schedule_highlight()

    def toggle_wrap(self):
        self.wrap_on = not self.wrap_on
        self.text.configure(wrap="word" if self.wrap_on else "none")
        if self.wrap_on:
            self.xs.pack_forget()
        else:
            self.xs.pack(side="bottom", fill="x", before=self.gutter if self.show_lines else self.text)
        self.refresh()

    # ---------- syntax highlight ----------
    def set_language(self):
        name = detect_lang(self.path, self.text.get("1.0", "1.end"))
        for tag in SYN_COLORS:
            self.text.tag_remove(tag, "1.0", "end")
        self.lang_name = LANG_LABEL.get(name, "") if name else ""
        self.lang_rx = get_lang_rx(name) if name else None
        self.lang_key = name
        self._hl_range = (0, -1)
        self.text.tag_remove("occ", "1.0", "end")
        self.schedule_occ(30)
        if self.lang_rx:
            self.schedule_highlight(20)
        self._detect_indent()

    def schedule_highlight(self, delay=150):
        if self.lang_rx is None:
            return
        if self._hl_job is not None:
            self.root.after_cancel(self._hl_job)
        self._hl_job = self.root.after(delay, self.highlight)

    def _on_key_release(self, e):
        if e.keysym not in NAV_KEYS:
            self.schedule_highlight()
        if e.keysym not in MOD_KEYS:
            self.schedule_occ()

    def _on_yscroll(self, first, last):
        self.ys.set(first, last)
        self._schedule_gutter()
        self.schedule_occ(150)
        self._maybe_rehighlight()

    def _visible_lines(self):
        t = self.text
        first = int(t.index("@0,0").split(".")[0])
        last = int(t.index(f"@0,{max(t.winfo_height(), 1)}").split(".")[0])
        return first, last

    def _maybe_rehighlight(self):
        if self.lang_rx is None or self._hl_job is not None:
            return
        first, last = self._visible_lines()
        total = int(self.text.index("end-1c").split(".")[0])
        a, b = self._hl_range
        if (first - 30 < a and a > 1) or (last + 30 > b and b < total):
            self._hl_job = self.root.after(30, self.highlight)

    def highlight(self):
        self._hl_job = None
        rx = self.lang_rx
        if rx is None:
            return
        t = self.text
        total = int(t.index("end-1c").split(".")[0])
        first, last = self._visible_lines()
        a, b = max(1, first - PAD_LINES), min(total, last + PAD_LINES)
        s_line, e_line = (1, total) if total <= FULL_SCAN_LINES else (a, b)
        text = t.get(f"{s_line}.0", f"{e_line}.end")

        starts, i = [0], text.find("\n")
        while i != -1:
            starts.append(i + 1)
            i = text.find("\n", i + 1)

        lo, hi = a - s_line, b - s_line  # phạm vi dòng (tương đối) cần tô
        ranges = {}
        for tag, s, e in tokenize(rx, text):
            ls = bisect_right(starts, s) - 1
            if ls > hi:
                break
            le = bisect_right(starts, e - 1) - 1
            if le < lo:
                continue
            ranges.setdefault(tag, []).extend(
                (f"{s_line + ls}.{s - starts[ls]}", f"{s_line + le}.{e - starts[le]}"))
        for tag in SYN_COLORS:
            t.tag_remove(tag, f"{a}.0", f"{b}.end")
        for tag, idx in ranges.items():
            t.tag_add(tag, *idx)
        self._hl_range = (a, b)

    # ---------- ui ----------
    def refresh(self):
        line, col = self.text.index("insert").split(".")
        name = os.path.basename(self.path) if self.path else "Chưa đặt tên"
        mod = self.text.edit_modified()
        self.root.title(f"{'● ' if mod else ''}{name} — ted")
        self.status.config(text=f"{name}{' [đã sửa]' if mod else ''}    Dòng {line}, Cột {int(col) + 1}    UTF-8{'    ' + self.lang_name if self.lang_name else ''}{'    Wrap' if self.wrap_on else ''}")
        self._schedule_gutter()

    def run(self):
        self.root.mainloop()


def detach():
    """Tách khỏi terminal (như gedit, code): terminal gõ lệnh tiếp được ngay và đóng terminal không làm tắt ted.
    Phải gọi TRƯỚC khi tạo cửa sổ Tk. Output và lỗi của ted được ghi vào ~/.cache/ted/ted.log."""
    if not hasattr(os, "fork"):
        return
    try:
        if os.fork() > 0:
            os._exit(0)  # tiến trình cha thoát ngay -> terminal được trả lại
        os.setsid()      # thoát khỏi phiên của terminal (không nhận SIGHUP khi đóng terminal)
        if os.fork() > 0:
            os._exit(0)
    except OSError:
        return           # không fork được thì cứ chạy như bình thường
    devnull = os.open(os.devnull, os.O_RDWR)
    try:
        base = os.environ.get("XDG_CACHE_HOME") or os.path.join(os.path.expanduser("~"), ".cache")
        os.makedirs(os.path.join(base, "ted"), exist_ok=True)
        log = os.open(os.path.join(base, "ted", "ted.log"), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o644)
    except OSError:
        log = devnull
    os.dup2(devnull, 0)
    os.dup2(log, 1)
    os.dup2(log, 2)


if __name__ == "__main__":
    args = sys.argv[1:]
    foreground = False
    for flag in ("-f", "--foreground"):
        if flag in args:
            args.remove(flag)
            foreground = True
    if args and args[0] in ("-h", "--help"):
        print("Dùng: ted [-f] [tên file]   (-f: giữ terminal chờ, để xem lỗi; mặc định ted tự tách khỏi terminal)\n"
              "  Ctrl+S lưu · Ctrl+O mở · Ctrl+F tìm · Ctrl+H thay · Ctrl+G đến dòng\n"
              "  Ctrl+/ comment · Tab/Shift+Tab thụt lề · Alt+Z xuống dòng · Ctrl+L số dòng · Alt+H tô chữ trùng · F5 chạy file · Ctrl+J khung Output · Ctrl+Q thoát")
        sys.exit(0)
    if args and args[0] in ("-v", "--version"):
        print(f"ted {VERSION}")
        sys.exit(0)
    if not os.environ.get("DISPLAY"):
        sys.exit("ted: không thấy màn hình đồ họa (biến DISPLAY trống). Hãy chạy trong phiên desktop.")
    if not foreground and (sys.stdin.isatty() or sys.stdout.isatty()):  # chạy từ terminal -> tách ra
        detach()
    Editor(args[0] if args else None).run()
