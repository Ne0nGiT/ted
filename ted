            st.map(name, background=[("active", "#686868"), ("pressed", "#808080")])

    # ---------- cuộn mượt hơn: gộp các lệnh kéo thanh cuộn ----------
    def _yview(self, *args):
        if args and args[0] == "moveto":
            self._pending_y = args
            if self._scroll_job is None:
                self._scroll_job = self.root.after(15, self._flush_scroll)
        else:
            self.text.yview(*args)

    def _flush_scroll(self):
        self._scroll_job = None
        if self._pending_y:
            self.text.yview(*self._pending_y)
            self._pending_y = None

    # ---------- file ----------
    def load(self):
        if self.path and os.path.isfile(self.path):
            try:
                with open(self.path, "r", encoding="utf-8") as f:
                    data = f.read()
            except UnicodeDecodeError:
                with open(self.path, "r", encoding="latin-1") as f:
                    data = f.read()
            except OSError as e:
                show_error(self.root, f"Không mở được file:\n{e}")
                data = ""
            self.text.insert("1.0", data)
        self.text.edit_reset()
        self.text.edit_modified(False)
        self.text.mark_set("insert", "1.0")
        self._restore_pos()

    def save(self, _e=None):
        if not self.path:
            return self.save_as()
        try:
            data = self.text.get("1.0", "end-1c")
            if data and not data.endswith("\n"):
                data += "\n"  # như nano: luôn có newline cuối file
            with open(self.path, "w", encoding="utf-8") as f:
                f.write(data)
        except OSError as e:
            show_error(self.root, f"Không lưu được:\n{e}")
            return "break"
        self.text.edit_modified(False)
        self.refresh()
        return "break"

    def save_as(self, _e=None):
        start = self.path or os.path.join(os.getcwd(), "")
        p = pick_file(save=True, initial=start)
        if p:
            self.path = os.path.abspath(p)
            self.set_language()
            self.save()
        return "break"

    def open_file(self, _e=None):
        if not self.confirm_discard():
            return "break"
        self._save_pos()
        p = pick_file(save=False, initial=os.path.join(os.path.dirname(self.path or os.getcwd()), ""))
        if p:
            self.text.delete("1.0", "end")
            self.path = os.path.abspath(p)
            self.load()
            self.set_language()
            self.refresh()
        return "break"

    def confirm_discard(self):
        if not self.text.edit_modified():
            return True
        ans = ask_save(self.root)
        if ans is None:
            return False
        if ans == "save":
            self.save()
            return not self.text.edit_modified()
        return True

    def quit(self, _e=None):
        if self.confirm_discard():
            self._save_pos()
            self.stop_run(quiet=True, force=True)
            self.root.destroy()
        return "break"

